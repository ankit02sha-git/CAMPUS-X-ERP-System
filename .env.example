# --- Required ---
# SQLite file, created automatically by `npm run db:setup`. No database server or Docker needed.
DATABASE_URL="file:./dev.db"
# generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Seed accounts (never commit real values). Seed refuses to run in production without them. ---
SEED_ADMIN_EMAIL="admin@campusx.local"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_STUDENT_PASSWORD=""

# --- File storage (optional in dev: falls back to ./public/uploads) ---
# Set all three to use Cloudinary (recommended for production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Twilio Verify service for real SMS OTP delivery (activation & forgot-password) ---
# Configure your Twilio Account SID, Auth Token (or API Key/Secret), and Verify Service SID.
# Never commit real values. Never expose these via NEXT_PUBLIC_* variables.
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_API_KEY="your_twilio_api_key"
TWILIO_API_SECRET="your_twilio_api_secret"
TWILIO_VERIFY_SERVICE_SID="your_twilio_verify_service_sid"
